FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS backend
ENV UV_LINK_MODE=copy
ENV UV_PYTHON_DOWNLOADS=0
# docker-compose.dev.yaml bind-mounts ./services/backend over /app, which would shadow a
# venv living in the project directory — and the host's own .venv is built for
# the host's platform anyway.
ENV UV_PROJECT_ENVIRONMENT=/opt/venv
ENV PATH="/opt/venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1
# The project is not installed into the venv, so `src` is importable only by
# path. Relying on the cwd alone breaks pytest, which inserts its own rootdir.
ENV PYTHONPATH=/app
# Keeps bytecode out of the bind-mounted tree. Sharing __pycache__ with the host
# is harmless but makes every traceback quote host paths for container frames.
ENV PYTHONPYCACHEPREFIX=/tmp/pycache

WORKDIR /app
# Dev groups included: the same image runs pytest, ruff, and mypy.
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=services/backend/uv.lock,target=uv.lock \
    --mount=type=bind,source=services/backend/pyproject.toml,target=pyproject.toml \
    uv sync --frozen --no-install-project

# ------------------------------------------------

# Tracks the npm major the lockfile was written with: an older npm rewrites
# fields it does not know (`libc`), dirtying package-lock.json on every `up`.
FROM node:26-slim AS frontend
ENV NODE_ENV=development
WORKDIR /app
# Seeds the node_modules volume with Linux binaries on first `up`, so the
# platform-specific swc and rolldown builds never come from the host mount.
COPY services/frontend/package*.json ./
RUN npm ci --no-audit --no-fund
