# Copy to .env and fill in. See README.md#configuration for the full reference.

# --- The compose examples --------------------------------------------------
# Only these are read by compose.example.yaml and compose.split.example.yaml;
# everything further down is for docker-compose.dev.yaml and running the
# backend directly.
#
# PUID=1000
# PGID=1000
# TZ=Etc/UTC
# compose.split.example.yaml only.
# RELEASARR_DB_PASSWORD=<random-password>

# --- Core ---------------------------------------------------------------
# Required when running the backend directly; the container generates one into
# /config/auth-secret when it is left unset. Generate with:
#   openssl rand -hex 32
RELEASARR_AUTH_SECRET=<random-secret>

# RELEASARR_DATABASE_URL=sqlite+aiosqlite:///./releasarr.db
# RELEASARR_DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<database>
# RELEASARR_LOG_LEVEL=INFO
# RELEASARR_LOG_JSON=false

# --- Auth -----------------------------------------------------------------
# RELEASARR_AUTH_ACCESS_TOKEN_TTL_SECONDS=900
# RELEASARR_AUTH_REFRESH_TOKEN_TTL_SECONDS=86400
# RELEASARR_AUTH_REFRESH_REMEMBER_TTL_SECONDS=2592000
# Set to true behind a TLS reverse proxy; over plain HTTP it breaks login.
# RELEASARR_AUTH_COOKIE_SECURE=false
# RELEASARR_AUTH_COOKIE_SAMESITE=lax
# RELEASARR_AUTH_MAX_FAILED_LOGINS=10
# RELEASARR_AUTH_LOCKOUT_SECONDS=900
# RELEASARR_AUTH_REFRESH_REUSE_GRACE_SECONDS=15

# --- Tasks -----------------------------------------------------------------
# Re-grab pacing: how many releases one run may check from a single indexer (a
# larger backlog is spread over several runs), and how long to wait between two
# checks against the same indexer. Both are editable in the UI.
# RELEASARR_MAX_REGRABS_PER_INDEXER_PER_EXECUTION=20
# RELEASARR_REGRAB_INDEXER_DELAY_SECONDS=2.0

# --- Sonarr and Radarr ------------------------------------------------------
RELEASARR_SONARR_URL=<sonarr url>
RELEASARR_SONARR_API_KEY=<token>
RELEASARR_RADARR_URL=<radarr url>
RELEASARR_RADARR_API_KEY=<token>
# RELEASARR_SONARR_QUALITY_PROFILE_ID=
# RELEASARR_RADARR_QUALITY_PROFILE_ID=

# --- Metadata providers -----------------------------------------------------
RELEASARR_TVDB_API_KEY=<token>
RELEASARR_TMDB_API_KEY=<token>
# Add "rus" (or any ISO 639-2 code) to fetch titles and overviews in that language too.
# RELEASARR_METADATA_LANGUAGES=["eng"]

# --- Prowlarr ----------------------------------------------------------
RELEASARR_PROWLARR_URL=<prowlarr url>
RELEASARR_PROWLARR_API_KEY=<token>
# RELEASARR_PROWLARR_CATEGORIES=
# RELEASARR_PROWLARR_SEARCH_TIMEOUT=10.0
# RELEASARR_PROWLARR_SEARCH_RETRIES=1
# RELEASARR_PROWLARR_SEARCH_CONCURRENCY=5

# --- qBittorrent -------------------------------------------------------
RELEASARR_QBITTORRENT_URL=<qbittorrent url>
RELEASARR_QBITTORRENT_USERNAME=admin
RELEASARR_QBITTORRENT_PASSWORD=<password>
# RELEASARR_QBITTORRENT_SAVE_PATH=
# RELEASARR_QBITTORRENT_CATEGORY=
# RELEASARR_QBITTORRENT_TAG_PREFIX=
# RELEASARR_QBITTORRENT_PAUSED=false
