# Copy to .env and fill in. See README.md#configuration for the full reference.

# --- Core ---------------------------------------------------------------
# Required, no default — the app refuses to start without it. Generate with:
#   openssl rand -hex 32
RELEASARR_AUTH_SECRET=<random-secret>

# RELEASARR_DATABASE_URL=sqlite+aiosqlite:///./releasarr.db
# RELEASARR_DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<database>
# RELEASARR_LOG_LEVEL=INFO
# RELEASARR_LOG_JSON=false

# --- Auth -----------------------------------------------------------------
# RELEASARR_AUTH_ACCESS_TOKEN_TTL_SECONDS=900
# RELEASARR_AUTH_REFRESH_TOKEN_TTL_SECONDS=86400
# RELEASARR_AUTH_REFRESH_REMEMBER_TTL_SECONDS=2592000
# RELEASARR_AUTH_COOKIE_SECURE=true
# RELEASARR_AUTH_COOKIE_SAMESITE=lax
# RELEASARR_AUTH_MAX_FAILED_LOGINS=10
# RELEASARR_AUTH_LOCKOUT_SECONDS=900
# RELEASARR_AUTH_REFRESH_REUSE_GRACE_SECONDS=15

# --- Sonarr and Radarr ------------------------------------------------------
RELEASARR_SONARR_URL=<sonarr url>/api/v3
RELEASARR_SONARR_API_KEY=<token>
RELEASARR_RADARR_URL=<radarr url>/api/v3
RELEASARR_RADARR_API_KEY=<token>
# RELEASARR_SONARR_QUALITY_PROFILE_ID=
# RELEASARR_RADARR_QUALITY_PROFILE_ID=

# --- Metadata providers -----------------------------------------------------
RELEASARR_TVDB_API_KEY=<token>
RELEASARR_TMDB_API_KEY=<token>
# RELEASARR_METADATA_LANGUAGES=["eng", "rus"]

# --- Prowlarr ----------------------------------------------------------
RELEASARR_PROWLARR_URL=<prowlarr url>/api/v1
RELEASARR_PROWLARR_API_KEY=<token>
# RELEASARR_PROWLARR_CATEGORIES=
# RELEASARR_PROWLARR_SEARCH_TIMEOUT=10.0
# RELEASARR_PROWLARR_SEARCH_RETRIES=1
# RELEASARR_PROWLARR_SEARCH_CONCURRENCY=5

# --- qBittorrent -------------------------------------------------------
RELEASARR_QBITTORRENT_URL=<qbittorrent url>/api/v2
RELEASARR_QBITTORRENT_USERNAME=admin
RELEASARR_QBITTORRENT_PASSWORD=<password>
# RELEASARR_QBITTORRENT_SAVE_PATH=
# RELEASARR_QBITTORRENT_CATEGORY=
# RELEASARR_QBITTORRENT_TAG_PREFIX=
# RELEASARR_QBITTORRENT_PAUSED=false
