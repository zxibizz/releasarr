{
  "name": "frontend_new",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@chakra-ui/icons": "^2.0.21",
    "@chakra-ui/react": "^2.8.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@tanstack/react-query": "^5.90.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.16",
    "msw": "^2.3.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "web-vitals": "^2.1.4",
    "zod": "^3.25.76"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --project-token $CHROMATIC_PROJECT_TOKEN",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"mock-server/**/*.ts\" vite.config.ts",
    "format": "prettier --write .",
    "codegen": "openapi-zod-client ../openapi.yaml -o src/generated/releasarr.ts --export-schemas --with-docs && node scripts/post-codegen.mjs && openapi-typescript ../openapi.yaml --output src/generated/releasarr-types.ts",
    "mock:server": "cross-env MOCK_SERVER_PORT=8001 tsx watch mock-server/index.ts",
    "dev:mock": "concurrently -k -n mock,app \"npm run mock:server\" \"cross-env VITE_API_URL=http://localhost:8001/api vite\"",
    "prepare": "npx simple-git-hooks"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@storybook/test": "^8.6.14",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.7.5",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.10.0",
    "@vitejs/plugin-react-swc": "^3.7.0",
    "chromatic": "^11.12.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "cross-env": "^10.0.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "express": "^5.1.0",
    "globals": "^15.8.0",
    "lint-staged": "^15.2.10",
    "morgan": "^1.10.1",
    "openapi-typescript": "^7.9.1",
    "openapi-zod-client": "^1.18.3",
    "prettier": "^3.3.3",
    "simple-git-hooks": "^2.11.1",
    "storybook": "^8.6.14",
    "tsx": "^4.20.5",
    "typescript": "^5.4.5",
    "vite": "^5.4.3",
    "vitest": "^1.6.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "cd frontend_new && npx lint-staged"
  }
}
