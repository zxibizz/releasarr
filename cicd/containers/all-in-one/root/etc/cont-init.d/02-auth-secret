#!/command/with-contenv sh
# The API refuses to start without a signing secret. Rather than make every
# user invent one, generate it once and keep it in /config across restarts.
set -e

if [ -n "${RELEASARR_AUTH_SECRET:-}" ]; then
    exit 0
fi

secret_file=/config/auth-secret
if [ ! -s "${secret_file}" ]; then
    (
        umask 077
        /app/.venv/bin/python -c "import secrets; print(secrets.token_urlsafe(48))" > "${secret_file}"
    )
    chown "${PUID:-1000}:${PGID:-1000}" "${secret_file}"
    echo "generated RELEASARR_AUTH_SECRET into ${secret_file}"
fi

# with-contenv reads each file here whole and unchomped, so no trailing newline.
printf '%s' "$(cat "${secret_file}")" > /run/s6/container_environment/RELEASARR_AUTH_SECRET
