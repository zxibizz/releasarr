# Rendered at boot by /etc/cont-init.d/04-nginx-site: __URL_BASE__ becomes the
# URL base ("" at the root, otherwise "/segment..."), __WEB_ROOT__ the directory
# under which /static answers at that path.

# The *arr apps accept the API key as ?apikey=, and an access log is where a
# credential in a URL leaks from.
map $request $releasarr_logged_request {
  "~*^(?<head>.*[?&]apikey=)[^&\s]*(?<tail>.*)$" "${head}(removed)${tail}";
  default $request;
}
log_format releasarr '$remote_addr - $remote_user [$time_local] "$releasarr_logged_request" '
  '$status $body_bytes_sent "$http_referer" "$http_user_agent"';

server {
  listen 8050;
  merge_slashes off;
  # Debian's defaults write both to /var/log/nginx, where nothing rotates them
  # and nobody reads them. Sending them to the service's own descriptors puts
  # them in `docker logs`, tagged by the s6 logger.
  access_log /dev/stdout releasarr;
  error_log /dev/stderr;
  root __WEB_ROOT__;
  # Debian's stock nginx.conf ships gzip commented out, so the bundle used to
  # cross the network uncompressed.
  gzip on;
  gzip_vary on;
  gzip_min_length 1024;
  gzip_types text/css text/javascript application/javascript application/json
    application/manifest+json image/svg+xml;
  # The URL base is stripped here and nowhere else; the API owns /api/v1 itself.
  location __URL_BASE__/api/ {
    proxy_pass http://127.0.0.1:8000/api/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
  location = __URL_BASE__/ping {
    proxy_pass http://127.0.0.1:8000/ping;
  }
  # Behind a TLS proxy an absolute redirect would name this listener's own
  # scheme and port, which the browser cannot reach.
  absolute_redirect off;
  # Never matches at the root, where the URI is never empty.
  location ~ ^__URL_BASE__$ {
    return 301 __URL_BASE__/;
  }
  # A cached worker is a visitor stuck on a build the server no longer has, and
  # no later deploy can reach them, so this one file must always be revalidated.
  location = __URL_BASE__/sw.js {
    add_header Cache-Control "no-cache";
  }
  # try_files' last argument is an internal redirect, which re-runs location
  # matching, so the SPA fallback is covered by this too. The build is made
  # with relative URLs, so this one tag is what places it under the URL base.
  location = __URL_BASE__/index.html {
    add_header Cache-Control "no-cache";
    sub_filter '<base href="/" />' '<base href="__URL_BASE__/" />';
    sub_filter_once on;
  }
  location = __URL_BASE__/manifest.webmanifest {
    # Harmless if mime.types already knows webmanifest; the wrong type makes a
    # browser ignore the manifest without saying so.
    default_type application/manifest+json;
    add_header Cache-Control "no-cache";
  }
  # Vite puts a content hash in every name here, so a URL's contents never
  # change. `=404` matters as much as the header: the SPA fallback would
  # otherwise answer a missing chunk with HTML, which parses as a syntax error.
  location __URL_BASE__/assets/ {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }
  location __URL_BASE__/ {
    try_files $uri $uri/ __URL_BASE__/index.html;
  }
}
